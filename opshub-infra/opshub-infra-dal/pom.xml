<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nianliu.opshub</groupId>
        <artifactId>opshub-infra</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>opshub-infra-dal</artifactId>
    <version>${infra.dal.release.version}</version>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-domain-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-infra-integration</artifactId>
        </dependency>

        <!-- ==================== 三方依赖：仅基础设施层可直接依赖（§2.5 外部依赖唯一出口） ==================== -->

        <!-- ORM 持久层：MyBatis-Flex（适配 Spring Boot 3 / Jakarta EE 9+）；
             其传递的 spring-boot-autoconfigure 2.7.11 由根 POM 的 spring-boot-dependencies BOM 覆盖为 3.5.16 -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
        </dependency>

        <!-- 数据库驱动：版本随 Spring Boot BOM（runtime 作用域，不污染编译期） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 数据访问基础设施：spring-jdbc + HikariCP 连接池（datasource.xml 中的 dataSource 需要） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 编译期样板代码消除 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
