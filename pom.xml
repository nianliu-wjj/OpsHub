<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nianliu.opshub</groupId>
    <artifactId>OpsHub</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OpsHub</name>
    <description>按《Java 后端编码规范》五层模块群组织的多模块工程（启动装配 / 接口契约 / 接口实现 / 领域 / 基础设施）</description>

    <modules>
        <module>opshub-api</module>
        <module>opshub-biz</module>
        <module>opshub-bootstrap</module>
        <module>opshub-common</module>
        <module>opshub-domain</module>
        <module>opshub-infra</module>
        <module>opshub-test</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 各模块独立发布版本号，不随工程快照波动（编码规范 §2.4 规则 3） -->
        <api.release.version>1.0.0</api.release.version>
        <common.release.version>1.0.0</common.release.version>
        <domain.model.release.version>1.0.0</domain.model.release.version>
        <domain.service.release.version>1.0.0</domain.service.release.version>
        <infra.dal.release.version>1.0.0</infra.dal.release.version>
        <infra.integration.release.version>1.0.0</infra.integration.release.version>
        <biz.shared.release.version>1.0.0</biz.shared.release.version>
        <biz.impl.release.version>1.0.0</biz.impl.release.version>
        <bootstrap.release.version>1.0.0</bootstrap.release.version>
        <test.release.version>1.0.0</test.release.version>

        <!-- 三方依赖版本号：统一在根 POM 收敛，子模块声明依赖不带版本号（编码规范 §2.5.3） -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>
        <mybatis-flex.version>1.11.8</mybatis-flex.version>
        <springdoc.version>2.8.17</springdoc.version>
        <fastjson2.version>2.0.66</fastjson2.version>
        <commons-lang3.version>3.22.0</commons-lang3.version>
        <lombok.version>1.18.48</lombok.version>
        <testng.release.version>7.11.0</testng.release.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-domain-model</artifactId>
                <version>${domain.model.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-common</artifactId>
                <version>${common.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-infra-dal</artifactId>
                <version>${infra.dal.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-infra-integration</artifactId>
                <version>${infra.integration.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-domain-service</artifactId>
                <version>${domain.service.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-biz-shared</artifactId>
                <version>${biz.shared.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-biz-impl</artifactId>
                <version>${biz.impl.release.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-bootstrap</artifactId>
                <version>${bootstrap.release.version}</version>
            </dependency>

            <!-- 接口契约：独立版本发布，不随工程快照波动（调用方只引契约，§2.4 规则 3） -->
            <dependency>
                <groupId>com.nianliu.opshub</groupId>
                <artifactId>opshub-api</artifactId>
                <version>${api.release.version}</version>
            </dependency>

            <dependency>
                <groupId>org.testng</groupId>
                <artifactId>testng</artifactId>
                <version>${testng.release.version}</version>
            </dependency>

            <!-- ==================== 三方依赖：版本只在根 POM 登记一次（§2.5.3） ==================== -->

            <!-- ORM 持久层：MyBatis-Flex（spring-boot3-starter 适配 Jakarta EE 9+，勿用 spring-boot-starter） -->
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>

            <!-- JSON 序列化：Fastjson2（规避 fastjson 1.x autotype 反序列化漏洞） -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- 通用工具：commons-lang3（显式高于 Boot BOM 默认 3.17.0，规避 CVE-2025-48924） -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <!-- 编译期样板代码消除：provided 作用域，不随模块传递 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- SpEL 基建（OpsLog 求值核继承 CachedExpressionEvaluator）与日志门面：版本随 Boot BOM，此处仅登记坐标 -->
            
            

            <!-- Spring Boot 3 依赖基线：Spring / Jackson / Tomcat / HikariCP / MySQL 驱动等版本统一由该 BOM 收敛，
                 放最后声明，确保上面的显式版本优先生效 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version></plugin>
            <!-- 编译器：全工程统一注解处理器 + 保留参数名（SpEL 按参数名取值的前提，编码规范 §8） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok.mapstruct.binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                                 <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                        <exclude>commons-logging:commons-logging</exclude>
                                    </excludes>
                                    <message>同类能力只允许统一实现，见编码规范 §2.5</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
