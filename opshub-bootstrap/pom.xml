<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nianliu.opshub</groupId>
        <artifactId>OpsHub</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>opshub-bootstrap</artifactId>
    <version>${bootstrap.release.version}</version>
    <packaging>jar</packaging>

    <dependencies><dependency><groupId>com.nianliu.opshub</groupId><artifactId>opshub-infra-integration</artifactId></dependency><dependency><groupId>org.springframework</groupId><artifactId>spring-jdbc</artifactId></dependency><dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
<dependency><groupId>com.nianliu.opshub</groupId><artifactId>opshub-domain-service</artifactId></dependency>
<dependency><groupId>com.nianliu.opshub</groupId><artifactId>opshub-infra-dal</artifactId></dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
<dependency><groupId>com.nianliu.opshub</groupId><artifactId>opshub-common</artifactId></dependency>
<dependency><groupId>com.nianliu.opshub</groupId><artifactId>opshub-api</artifactId></dependency>
<dependency><groupId>com.nianliu.opshub</groupId><artifactId>opshub-domain-model</artifactId></dependency>
<dependency><groupId>com.alibaba.fastjson2</groupId><artifactId>fastjson2-extension-spring6</artifactId><version>${fastjson2.version}</version></dependency>

        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-biz-impl</artifactId>
        </dependency>

        <!-- ==================== 三方依赖：启动装配层（唯一打包出口） ==================== -->

        <!-- Web / REST 接入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId><exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-json</artifactId></exclusion></exclusions>
        </dependency>

        <!-- AOP 切面（全局异常、幂等、限流等横切能力） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 参数校验（JSR-380）：Jakarta Validation + Hibernate Validator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 内嵌容器健康检查与指标 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 编译期样板代码消除 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试支持：仅 test 作用域 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>opshub</finalName>
        <plugins>
            <!-- Spring Boot 可执行 jar 打包（repackage） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
