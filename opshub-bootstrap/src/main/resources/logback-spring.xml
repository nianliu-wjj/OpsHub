<?xml version="1.0" encoding="UTF-8"?><configuration><springProperty scope="context" name="appName" source="spring.application.name" defaultValue="opshub"/><property name="LOG_HOME" value="${LOG_PATH:-logs}"/>
<appender name="FILE_biz" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>${LOG_HOME}/biz/${appName}-biz.log</file><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>${LOG_HOME}/biz/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern><maxFileSize>200MB</maxFileSize><maxHistory>30</maxHistory><totalSizeCap>5GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart></rollingPolicy>
<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%-5level|%thread|%X{traceId:-}|%logger{50}|%msg%n</pattern><charset>UTF-8</charset></encoder></appender><appender name="ASYNC_biz" class="ch.qos.logback.classic.AsyncAppender"><queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>false</neverBlock><appender-ref ref="FILE_biz"/></appender>
<appender name="FILE_monitor" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>${LOG_HOME}/monitor/${appName}-monitor.log</file><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>${LOG_HOME}/monitor/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern><maxFileSize>100MB</maxFileSize><maxHistory>15</maxHistory><totalSizeCap>1GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart></rollingPolicy>
<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%-5level|%thread|%X{traceId:-}|%logger{50}|%msg%n</pattern><charset>UTF-8</charset></encoder></appender><appender name="ASYNC_monitor" class="ch.qos.logback.classic.AsyncAppender"><queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>false</neverBlock><appender-ref ref="FILE_monitor"/></appender>
<appender name="FILE_dal" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>${LOG_HOME}/dal/${appName}-dal.log</file><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>${LOG_HOME}/dal/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern><maxFileSize>200MB</maxFileSize><maxHistory>7</maxHistory><totalSizeCap>3GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart></rollingPolicy>
<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%-5level|%thread|%X{traceId:-}|%logger{50}|%msg%n</pattern><charset>UTF-8</charset></encoder></appender><appender name="ASYNC_dal" class="ch.qos.logback.classic.AsyncAppender"><queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>false</neverBlock><appender-ref ref="FILE_dal"/></appender>
<appender name="FILE_oplog" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>${LOG_HOME}/oplog/${appName}-oplog.log</file><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>${LOG_HOME}/oplog/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern><maxFileSize>100MB</maxFileSize><maxHistory>60</maxHistory><totalSizeCap>2GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart></rollingPolicy>
<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%X{traceId:-}|%msg%n</pattern><charset>UTF-8</charset></encoder></appender><appender name="ASYNC_oplog" class="ch.qos.logback.classic.AsyncAppender"><queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>false</neverBlock><appender-ref ref="FILE_oplog"/></appender>
<appender name="FILE_error" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>${LOG_HOME}/error/${appName}-error.log</file><rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy"><fileNamePattern>${LOG_HOME}/error/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern><maxFileSize>100MB</maxFileSize><maxHistory>60</maxHistory><totalSizeCap>2GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart></rollingPolicy>
<filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>ERROR</level></filter>
<encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS}|%-5level|%thread|%X{traceId:-}|%logger{50}|%msg%n</pattern><charset>UTF-8</charset></encoder></appender><appender name="ASYNC_error" class="ch.qos.logback.classic.AsyncAppender"><queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>false</neverBlock><appender-ref ref="FILE_error"/></appender>
<logger name="OP_LOG" level="INFO" additivity="false"><appender-ref ref="ASYNC_oplog"/><appender-ref ref="ASYNC_error"/></logger>
<logger name="MONITOR_SUMMARY" level="INFO" additivity="false"><appender-ref ref="ASYNC_monitor"/><appender-ref ref="ASYNC_error"/></logger>
<logger name="DAL_ACCESS" level="INFO" additivity="false"><appender-ref ref="ASYNC_dal"/><appender-ref ref="ASYNC_error"/></logger>
<logger name="com.nianliu.opshub.infra.dal.daointerface" level="INFO" additivity="false"><appender-ref ref="ASYNC_dal"/><appender-ref ref="ASYNC_error"/></logger>
<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%d{HH:mm:ss.SSS}|%-5level|%X{traceId:-}|%logger{40}|%msg%n</pattern></encoder></appender><root level="INFO"><appender-ref ref="ASYNC_biz"/><appender-ref ref="ASYNC_error"/></root><springProfile name="dev,test"><root level="INFO"><appender-ref ref="CONSOLE"/></root></springProfile></configuration>