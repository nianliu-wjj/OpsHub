<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nianliu.opshub</groupId>
        <artifactId>opshub-biz</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>opshub-biz-impl</artifactId>
    <version>${biz.impl.release.version}</version>
    <packaging>jar</packaging>


    <dependencies>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-biz-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-domain-service</artifactId>
        </dependency>
        <!-- 显式声明：直接引用 common 的注解/校验组件（传递依赖只作运行时可见保障，编译期类一律显式声明） -->
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-common</artifactId>
        </dependency>

        <!-- Web 契约：Controller 返回 Result 信封需要 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- 编译期样板代码消除（接口实现层使用 Lombok 简化 getter/setter/构造器） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
