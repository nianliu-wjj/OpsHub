<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nianliu.opshub</groupId>
        <artifactId>OpsHub</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>opshub-common</artifactId>
    <version>${common.release.version}</version>
    <packaging>jar</packaging>

    <dependencies>
<dependency><groupId>jakarta.validation</groupId><artifactId>jakarta.validation-api</artifactId></dependency>

        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-domain-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nianliu.opshub</groupId>
            <artifactId>opshub-api</artifactId>
        </dependency>

        <!-- ==================== 三方依赖：横切能力（日志门面 / 工具 / 序列化）唯一定义点 ==================== -->

        <!-- SpEL 基建：OpsLog 求值核继承 CachedExpressionEvaluator -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- 日志门面：横切组件只依赖 slf4j-api，实现由 bootstrap 装配层统一提供 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 通用工具：commons-lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- JSON 序列化：Fastjson2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 编译期样板代码消除 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
